{
  "version": 1,
  "hooks": {
    "workspaceOpen": [
      {
        "command": "py -3.11 .cursor/hooks/hive_workspace_open.py"
      }
    ],
    "sessionStart": [
      {
        "command": "py -3.11 .cursor/hooks/hive_session_start.py"
      }
    ],
    "stop": [
      {
        "command": "py -3.11 .cursor/hooks/hive_session_stop.py"
      },
      {
        "command": "py -3.11 .cursor/hooks/bug_hunt_continue.py",
        "timeout": 86400,
        "loop_limit": 210
      }
    ],
    "afterFileEdit": [
      {
        "command": "py -3.11 .cursor/hooks/hive_agents_lint.py",
        "matcher": "Write|TabWrite"
      }
    ]
  }
}
